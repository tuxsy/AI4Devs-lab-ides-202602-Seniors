// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CandidateStatus {
  ACTIVE
  IN_PROCESS
  HIRED
  REJECTED
  WITHDRAWN
}

enum DocumentType {
  CV
  COVER_LETTER
  OTHER
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String?
  candidates Candidate[]
}

model Candidate {
  id              String           @id @default(uuid())
  userId          String
  firstName       String
  lastName        String
  email           String           @unique
  phone           String?
  address         String?
  status          CandidateStatus
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  education       Education[]
  workExperiences WorkExperience[]
  documents       Document[]
}

model Education {
  id           String    @id @default(uuid())
  candidateId  String
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  candidate    Candidate @relation(fields: [candidateId], references: [id])
}

model WorkExperience {
  id          String    @id @default(uuid())
  candidateId String
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}

model Document {
  id          String       @id @default(uuid())
  candidateId String
  fileUri     String
  fileName    String
  mimeType    String
  size        Int
  type        DocumentType
  uploadedAt  DateTime     @default(now())
  candidate   Candidate    @relation(fields: [candidateId], references: [id])
}
